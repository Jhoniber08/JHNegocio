{
  "name": "JH Negocio (.NET 10)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "humao.rest-client"
      ]
    }
  },
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "JH Negocio API", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "dotnet restore JHNegocio.Api/JHNegocio.Api.csproj"
}
